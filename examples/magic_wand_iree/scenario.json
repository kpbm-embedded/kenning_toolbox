{
    "model_wrapper": {
        "type": "kenning.modelwrappers.classification.tflite_magic_wand.MagicWandModelWrapper",
        "parameters": {"model_path": "kenning:///models/classification/magic_wand.h5"}
    },
    "dataset": {
        "type": "kenning.datasets.magic_wand_dataset.MagicWandDataset",
        "parameters": {"dataset_root": "@DATASET@", "download_dataset": true}
    },
    "optimizers": [
        {
            "type": "kenning.optimizers.iree.IREECompiler",
            "parameters": {"backend": "@BACKEND@", "compiled_model_path": "@OUT@/magic_wand_@BACKEND@.vmfb"}
        }
    ],
    "runtime": {
        "type": "kenning.runtimes.iree.IREERuntime",
        "parameters": {"driver": "local-task", "save_model_path": "@OUT@/magic_wand_@BACKEND@.vmfb"}
    }
}
