{
    "model_wrapper": {
        "type": "kenning.modelwrappers.classification.tflite_magic_wand.MagicWandModelWrapper",
        "parameters": {"model_path": "kenning:///models/classification/magic_wand.h5"}
    },
    "dataset": {
        "type": "kenning.datasets.magic_wand_dataset.MagicWandDataset",
        "parameters": {"dataset_root": "@DATASET@", "download_dataset": true}
    },
    "optimizers": [
        {
            "type": "kenning.optimizers.tensorflow_pruning.TensorFlowPruningOptimizer",
            "parameters": {"compiled_model_path": "@OUT@/pruned.h5", "target_sparsity": @SPARSITY@, "epochs": 3,
                           "pruning_frequency": 20}
        },
        {
            "type": "kenning.optimizers.tflite.TFLiteCompiler",
            "parameters": {"target": "int8", "compiled_model_path": "@OUT@/pruned_int8.tflite",
                           "inferenceinputtype": "int8", "inferenceoutputtype": "int8"}
        }
    ],
    "runtime": {
        "type": "kenning.runtimes.tflite.TFLiteRuntime",
        "parameters": {"save_model_path": "@OUT@/pruned_int8.tflite"}
    }
}
