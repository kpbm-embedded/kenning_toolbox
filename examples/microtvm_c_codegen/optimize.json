{
    "model_wrapper": {
        "type": "kenning.modelwrappers.classification.tflite_magic_wand.MagicWandModelWrapper",
        "parameters": {"model_path": "kenning:///models/classification/magic_wand.h5"}
    },
    "dataset": {
        "type": "kenning.datasets.magic_wand_dataset.MagicWandDataset",
        "parameters": {"dataset_root": "@DATASET@", "download_dataset": true}
    },
    "optimizers": [
        {
            "type": "kenning.optimizers.tflite.TFLiteCompiler",
            "parameters": {"target": "default", "compiled_model_path": "@OUT@/magic_wand.tflite"}
        },
        {
            "type": "kenning.optimizers.tvm.TVMCompiler",
            "parameters": {"target": "zephyr", "compiled_model_path": "@OUT@/model/model.graph_data",
                           "zephyr_header_template": "@EXDIR@/model_impl.h.template", "module_name": "magic_wand",
                           "opt_level": 3, "conv2d_data_layout": "NHWC"}
        }
    ]
}
